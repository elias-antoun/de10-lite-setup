{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "de10-lite-visits",
  "send_metrics": false,
  "main": "worker.mjs",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://elias-antoun.github.io",
    "SITE_PATH": "/de10-lite-setup/",
    "RETENTION_DAYS": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "de10-lite-visits",
      // Replace with the UUID returned by `wrangler d1 create` before deploying.
      "database_id": "7b806b64-80e7-49cf-af4c-751401bc4ca2"
    }
  ],
  "triggers": { "crons": ["0 3 * * *"] }
}
